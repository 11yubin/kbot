      ],
      "id": "calendar-http-req-001",
      "name": "Calendar API"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst kst = new Date(new Date().getTime() + 9 * 60 * 60 * 1000);\nconst today = kst.toISOString().slice(0, 10);\n\nconst todayData = data.result.dates.find(d => d.ymd === today);\nif (!todayData) return [];\n\n// 팀코드 있는 KBO 실제 경기만\nconst kboGames = todayData.gameInfos.filter(g => g.homeTeamCode && g.awayTeamCode);\n\n// 한화(HH) 경기 없으면 아무것도 하지 않음\nconst hasHH = kboGames.some(g => g.homeTeamCode === 'HH' || g.awayTeamCode === 'HH');\nif (!hasHH) return [];\n\n// 경기별로 아이템 분리 → 다음 HTTP Request 노드가 각각 호출\nreturn kboGames.map(g => ({ json: { gameId: g.gameId } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "parse-calendar-001",
      "name": "gameId 목록 추출"
    },
    {
      "parameters": {
        "url": "={{ 'https://api-gw.sports.naver.com/schedule/games/' + $json.gameId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        624,
        0
      ],
      "id": "game-detail-req-001",
      "name": "경기 상세 API"
    },
    {
      "parameters": {
        "jsCode": "// 전체 경기 상세 모으기\nconst games = $input.all().map(item => item.json.result.game);\nconst HH = 'HH';\n\nconst hw = games.find(g => g.homeTeamCode === HH || g.awayTeamCode === HH);\nif (!hw) return [{ json: { hasGame: false } }];\n\nif (hw.cancel) return [{ json: { hasGame: true, cancel: true } }];\n\nconst isHome    = hw.homeTeamCode === HH;\nconst opponent  = isHome ? hw.awayTeamName  : hw.homeTeamName;\nconst stadium   = hw.stadium;\nconst gameTime  = hw.gameDateTime.slice(11, 16);\nconst hwStarter  = (isHome ? hw.homeStarterName  : hw.awayStarterName)  || '미정';\nconst oppStarter = (isHome ? hw.awayStarterName  : hw.homeStarterName)  || '미정';\nconst kstNow = new Date(new Date().getTime() + 9 * 60 * 60 * 1000);\nconst month = kstNow.getMonth() + 1;\nconst day   = kstNow.getDate();\n\nconst allGames = games\n  .sort((a, b) => a.gameDateTime.localeCompare(b.gameDateTime))\n  .map(g => {\n    const t  = g.gameDateTime.slice(11, 16);\n    const hs = g.homeStarterName || '미정';\n    const as = g.awayStarterName || '미정';\n    return `${g.awayTeamName} ${as} vs ${g.homeTeamName} ${hs} / ${g.stadium}, ${t}`;\n  })\n  .join('\\n');\n\nconst gameLink = `https://sports.naver.com/game/${hw.gameId}/record`;\nreturn [{ json: { hasGame: true, cancel: false, month, day, gameTime, opponent, stadium, isHome, hwStarter, oppStarter, allGames, gameLink } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "aggregate-format-001",
      "name": "집계 및 포맷"
    },
