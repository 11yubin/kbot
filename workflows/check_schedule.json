      "id": "cancel-telegram-schedule-001",
      "name": "경기 취소 알림"
    },
    {
      "parameters": {
        "jsCode": "const gameTime = $json.gameTime; // e.g. '18:30'\nconst [hour, minute] = gameTime.split(':');\n\nconst kstNow = new Date(new Date().getTime() + 9 * 60 * 60 * 1000);\nconst gameKst = new Date(kstNow.getFullYear(), kstNow.getMonth(), kstNow.getDate(), parseInt(hour, 10), parseInt(minute, 10));\n\n// 3시간 전 시간 계산\nconst pollingStartKst = new Date(gameKst.getTime() - 3 * 60 * 60 * 1000);\n\n// n8n Wait node를 위해 UTC ISO string으로 변환\nconst pollingStartUtc = new Date(pollingStartKst.getTime() - 9 * 60 * 60 * 1000).toISOString();\n\nreturn [{ json: { ...$json, waitTill: pollingStartUtc } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        -80
      ],
      "id": "calc-wait-time-001",
      "name": "폴링 대기시간 계산"
    },
