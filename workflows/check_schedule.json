              "value": "kbaseball"
            },
            {
              "name": "categoryIds",
              "value": ",kbo,kbs,kbaseballetc,premier12,apbc"
            },
            {
              "name": "date",
              "value": "={{ new Date(new Date().getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10) }}"
