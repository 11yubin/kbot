    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data;\n\nlet text = raw\n  .replace(/<[^>]*>/g, '')\n  .replace(/const\\s+\\w+[^;]*;/g, '')\n  .replace(/\\/\\/.*/g, '')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#x27;/g, \"'\")\n  .replace(/&#[0-9]+;/g, '')\n  .replace(/\\s{2,}/g, ' ')\n  .trim();\n\n// 본문 바로가기 이전 날리기\nconst bodyIdx = text.indexOf('본문 바로가기');\nif (bodyIdx !== -1) text = text.slice(bodyIdx);\n\nconst closeIdx = text.indexOf('닫기\"');\nif (closeIdx !== -1) text = text.slice(closeIdx + '닫기\"'.length);\n\n// 기자 패턴부터 시작\nconst startMatch = text.match(/\\[[^\\]]{2,40}기자\\]/);\nconst endKeyword = '현장에서 작성된 기사입니다';\n\nconst start = startMatch ? startMatch.index : 0;\nconst end = text.indexOf(endKeyword);\n\nconst article = end !== -1\n  ? text.slice(start, end + endKeyword.length)\n  : text.slice(start);\n\nreturn [{ json: { text: article } }];"
      },
